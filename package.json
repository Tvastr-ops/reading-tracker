{
  "name": "reading-tracker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:client": "cd apps/client && flutter run",
    "build:web": "pnpm --filter web build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:web": "pnpm --filter web test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
