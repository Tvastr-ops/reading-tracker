# Set default behavior to automatically normalize all text files to LF
* text=auto eol=lf

# Explicitly ensure source files and configs use LF
*.dart text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.sql text eol=lf

# Windows-specific batch scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (do not touch or normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.db binary
*.sqlite binary
*.wasm binary