# Supabase project (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
# Use the SERVICE ROLE key, not the anon key — this app talks to Supabase
# only from the server, so the powerful key never reaches the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your own login password for the app (pick something strong).
APP_PASSWORD=change-me

# Random 32+ char secret used to sign session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=generate-a-long-random-string
